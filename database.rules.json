{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      ".read": "auth.token.admin === true",
      ".indexOn": ["email"],
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
        ".write": "auth.token.admin === true",
        ".validate": "newData.hasChildren(['email','name','role','status'])",
        "email":     { ".validate": "newData.isString() && newData.val().length <= 254" },
        "name":      { ".validate": "newData.isString() && newData.val().length <= 120" },
        "role":      { ".validate": "newData.isString() && (newData.val() === 'admin' || newData.val() === 'user')" },
        "status":    { ".validate": "newData.isString() && (newData.val() === 'active' || newData.val() === 'inactive')" },
        "createdAt": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "deactivatedAt": { ".validate": "newData.isString() || newData.val() === null" },
        "$other":    { ".validate": false }
      }
    },

    "products": {
      ".read": "auth != null",
      ".write": "auth.token.admin === true",
      "$pid": {
        ".validate": "newData.hasChildren(['name','quantity']) || !newData.exists()",
        "name":     { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200" },
        "quantity": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000" },
        "price":    { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)" },
        "barcode":  { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 64)" },
        "expiry":   { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 40)" },
        "scope":    { ".validate": "!newData.exists() || (newData.isString() && (newData.val() === 'oil' || newData.val() === 'filter' || newData.val() === 'maghsal' || newData.val() === 'other' || newData.val() === 'oil-filter' || newData.val() === 'maghsal-consumable' || newData.val() === 'maghsal-goods'))" },
        "itemType": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 40)" },
        "unit":     { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 40)" },
        "$other":   { ".validate": true }
      }
    },

    "heldProducts": {
      ".read": "auth != null",
      ".write": "auth.token.admin === true"
    },

    "customers": {
      ".read": "auth != null",
      ".write": "auth.token.admin === true",
      "$cid": {
        "name":       { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200" },
        "nameArabic": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 200)" },
        "$other":     { ".validate": true }
      }
    },

    "productArchives": {
      ".read": "auth.token.admin === true",
      ".write": "auth.token.admin === true"
    },

    "stockArchives": {
      ".read": "auth.token.admin === true",
      ".write": "auth.token.admin === true"
    },

    "stockChecks": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "stockCheckHistory": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "SoldItems": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$id": {
        ".validate": "newData.hasChildren() || !newData.exists()",
        "$field": { ".validate": "!newData.isString() || newData.val().length <= 500" }
      }
    },

    "transactions": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$id": {
        ".validate": "newData.hasChildren() || !newData.exists()",
        "$field": { ".validate": "!newData.isString() || newData.val().length <= 500" }
      }
    },

    "maghsalEntries": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$id": {
        ".validate": "newData.hasChildren() || !newData.exists()",
        "customerId":         { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 120)" },
        "customerName":       { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 200)" },
        "customerNameArabic": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 200)" },
        "date":               { ".validate": "newData.isString() && newData.val().length <= 40" },
        "category":           { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 80)" },
        "price":              { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000" },
        "servicePrice":       { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000)" },
        "goodsTotal":         { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000)" },
        "totalPrice":         { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000)" },
        "consumablesUsed":    { ".validate": "!newData.exists() || newData.hasChildren()" },
        "goodsSold":          { ".validate": "!newData.exists() || newData.hasChildren()" },
        "paymentStatus":      { ".validate": "newData.isString() && (newData.val() === 'Paid' || newData.val() === 'Unpaid')" },
        "employee":           { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 200)" },
        "employeeId":         { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 120)" },
        "remark":             { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 500)" },
        "createdAt":          { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 40)" },
        "$other":             { ".validate": false }
      }
    },


    "settings": {
      ".read": "auth != null",
      ".write": "auth.token.admin === true",
      "maghsalCategories": {
        ".validate": "newData.hasChildren() || !newData.exists()",
        "$idx": { ".validate": "newData.isString() && newData.val().length <= 80" }
      }
    },

    "maghsalMigrations": {
      ".read": "auth.token.admin === true",
      ".write": "auth.token.admin === true"
    }
  }
}
