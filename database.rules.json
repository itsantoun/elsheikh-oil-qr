{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      ".read": "auth.token.admin === true || auth.token.email === 'doris@elsheikh.lb'",
      ".indexOn": ["email"],
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true || auth.token.email === 'doris@elsheikh.lb')",
        ".write": "auth.token.admin === true || auth.token.email === 'doris@elsheikh.lb'",
        ".validate": "newData.hasChildren(['email','name','role','status'])",
        "email":     { ".validate": "newData.isString() && newData.val().length <= 254" },
        "name":      { ".validate": "newData.isString() && newData.val().length <= 120" },
        "role":      { ".validate": "newData.isString() && (newData.val() === 'admin' || newData.val() === 'user')" },
        "status":    { ".validate": "newData.isString() && (newData.val() === 'active' || newData.val() === 'inactive')" },
        "createdAt": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "deactivatedAt": { ".validate": "newData.isString() || newData.val() === null" },
        "$other":    { ".validate": false }
      }
    },

    "products": {
      ".read": "auth != null",
      ".write": "auth.token.admin === true || auth.token.email === 'doris@elsheikh.lb'",
      "$pid": {
        ".validate": "newData.hasChildren(['name','quantity']) || !newData.exists()",
        "name":     { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200" },
        "quantity": {
          ".write": "auth.token.admin === true || auth.token.email === 'doris@elsheikh.lb' || (auth != null && newData.exists())",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
        },
        "price":    { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)" },
        "barcode":  { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 64)" },
        "expiry":   { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 40)" },
        "scope":    { ".validate": "!newData.exists() || (newData.isString() && (newData.val() === 'oil' || newData.val() === 'filter' || newData.val() === 'maghsal' || newData.val() === 'other' || newData.val() === 'oil-filter' || newData.val() === 'maghsal-consumable' || newData.val() === 'maghsal-goods'))" },
        "itemType": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 40)" },
        "unit":     { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 40)" },
        "updatedAt": {
          ".write": "auth.token.admin === true || auth.token.email === 'doris@elsheikh.lb' || (auth != null && newData.exists())",
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "$other":   { ".validate": true }
      }
    },

    "heldProducts": {
      ".read": "auth != null",
      ".write": "auth.token.admin === true || auth.token.email === 'doris@elsheikh.lb'"
    },

    "customers": {
      ".read": "auth != null",
      ".write": "auth.token.admin === true || auth.token.email === 'doris@elsheikh.lb'",
      "$cid": {
        "name":        { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200" },
        "nameArabic":  { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 200)" },
        "phone":       { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 30)" },
        "address":     { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 500)" },
        "clientTypes": { ".validate": "!newData.exists() || newData.hasChildren()" },
        "$other":      { ".validate": true }
      }
    },

    "employees": {
      ".read": "auth.token.admin === true || auth.token.email === 'doris@elsheikh.lb'",
      ".write": "auth.token.admin === true || auth.token.email === 'doris@elsheikh.lb'",
      "$eid": {
        "name":         { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200" },
        "nationality":  { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 80)" },
        "phone":        { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 30)" },
        "salaryUSD":    { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)" },
        "salaryLBP":    { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)" },
        "$other":       { ".validate": true }
      }
    },

    "productArchives": {
      ".read": "auth.token.admin === true || auth.token.email === 'doris@elsheikh.lb'",
      ".write": "auth.token.admin === true || auth.token.email === 'doris@elsheikh.lb'"
    },

    "stockArchives": {
      ".read": "auth.token.admin === true || auth.token.email === 'doris@elsheikh.lb'",
      ".write": "auth.token.admin === true || auth.token.email === 'doris@elsheikh.lb'"
    },

    "stockChecks": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "stockCheckHistory": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "SoldItems": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$id": {
        ".validate": "newData.hasChildren() || !newData.exists()",
        "$field": { ".validate": "!newData.isString() || newData.val().length <= 500" }
      }
    },

    "transactions": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$id": {
        ".validate": "newData.hasChildren() || !newData.exists()",
        "$field": { ".validate": "!newData.isString() || newData.val().length <= 500" }
      }
    },

    "maghsalEntries": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$id": {
        ".validate": "newData.hasChildren() || !newData.exists()",
        "$field": { ".validate": "!newData.isString() || newData.val().length <= 1000" }
      }
    },

    "waterFillingEntries": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$id": {
        ".validate": "newData.hasChildren() || !newData.exists()",
        "$field": { ".validate": "!newData.isString() || newData.val().length <= 1000" }
      }
    },

    "waterDistributionEntries": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$id": {
        ".validate": "newData.hasChildren() || !newData.exists()",
        "$field": { ".validate": "!newData.isString() || newData.val().length <= 1000" }
      }
    },


    "settings": {
      ".read": "auth != null",
      ".write": "auth.token.admin === true || auth.token.email === 'doris@elsheikh.lb'",
      "maghsalCategories": {
        ".validate": "newData.hasChildren() || !newData.exists()",
        "$idx": { ".validate": "newData.isString() && newData.val().length <= 80" }
      }
    },

    "maghsalMigrations": {
      ".read": "auth.token.admin === true || auth.token.email === 'doris@elsheikh.lb'",
      ".write": "auth.token.admin === true || auth.token.email === 'doris@elsheikh.lb'"
    },

    "reports": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$id": {
        ".validate": "newData.hasChildren() || !newData.exists()"
      }
    }
  }
}
